# -----------------------------------------------------------------------------
# Strynkix Coding Academy LMS — Environment Variables Template
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit actual keys, tokens, or credentials into version control.
# -----------------------------------------------------------------------------

# Firebase Client Configuration (Public variables used by the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Emulator Controls
# Set to "true" to connect client SDK to local Firebase Emulators (Auth & Firestore)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=

# Firebase Server / Admin SDK Configuration (Private variables, server-side only)
# Read only by src/lib/server/firebase-admin.ts, which serves every trusted route:
#   POST /api/quiz/attempt          (quiz grading, C1/C4)
#   POST /api/content/review        (review, publishing, versions, C2/C3)
#   POST /api/content/assessment    (assessment-only authoring, C2/C3)
#   POST /api/admin/course-design   (Course Design membership, C5)
#   POST /api/admin/account-status  (approve/suspend/reactivate, C5)
# and by the legacy quiz migration CLI (npm run migration:quiz-keys, C4), which
# reads them from the operator's local shell, never from this file.
# Staging/Preview scope only; never set these for Production (the server
# refuses the production project). Without them the routes answer 503.
# Not needed under the emulators (FIRESTORE_EMULATOR_HOST + FIREBASE_AUTH_EMULATOR_HOST).
# See docs/STAGING_READINESS.md §13.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
