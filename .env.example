# -----------------------------------------------------------------------------
# Strynkix Coding Academy LMS — Environment Variables Template
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit actual keys, tokens, or credentials into version control.
# -----------------------------------------------------------------------------

# Firebase Client Configuration (Public variables used by the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Emulator Controls
# Set to "true" to connect client SDK to local Firebase Emulators (Auth & Firestore)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=

# Firebase Server / Admin SDK Configuration (Private variables, server-side only)
# Used exclusively in secure server-side route handlers or scripts
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
