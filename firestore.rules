rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions: Authentication & Role Verification
    // -------------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return getUserDoc().data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function getUserOrgId() {
      return getUserData().orgId;
    }

    function getUserBranchId() {
      return getUserData().get('branchId', '');
    }

    // A branch admin profile without a branchId must have no branch authority;
    // otherwise '' would match every unscoped user in the org.
    function isScopedBranchAdminRole() {
      return getUserRole() == 'branch_admin' && getUserBranchId() is string && getUserBranchId() != '';
    }

    function isAccountActive() {
      return userExists() && getUserData().get('status', 'active') == 'active';
    }

    function isSuperAdmin() {
      return isAuthenticated() && isAccountActive() && getUserRole() == 'super_admin';
    }

    function isUniversityAdmin(orgId) {
      return isAuthenticated() && isAccountActive() && getUserRole() == 'university_admin' && getUserOrgId() == orgId;
    }

    function isBranchAdmin(orgId, branchId) {
      return isAuthenticated() && isAccountActive() && isScopedBranchAdminRole() && getUserOrgId() == orgId && getUserBranchId() == branchId;
    }

    function isInstructor(orgId) {
      return isAuthenticated() && isAccountActive() && getUserRole() == 'instructor' && getUserOrgId() == orgId;
    }

    function isStudent(orgId) {
      return isAuthenticated() && isAccountActive() && getUserRole() == 'student' && getUserOrgId() == orgId;
    }

    function lessonExists(lessonId) {
      return exists(/databases/$(database)/documents/lessons/$(lessonId));
    }

    function getLessonDoc(lessonId) {
      return get(/databases/$(database)/documents/lessons/$(lessonId));
    }

    function isLessonPublishedAndInOrg(lessonId, orgId) {
      return lessonExists(lessonId) &&
        getLessonDoc(lessonId).data.orgId == orgId &&
        getLessonDoc(lessonId).data.get('status', '') == 'published';
    }

    // -------------------------------------------------------------------------
    // Helper Functions: Stage 6 Scope, Batches & Enrollments
    // -------------------------------------------------------------------------

    // Administrative authority over a branch: super admin, the org's university
    // admin, or that branch's own branch admin.
    function canManageBranch(orgId, branchId) {
      return isSuperAdmin() || isUniversityAdmin(orgId) || isBranchAdmin(orgId, branchId);
    }

    // Curriculum authoring authority within an organization.
    function canAuthorInOrg(orgId) {
      return isSuperAdmin() || (
        isAuthenticated() && isAccountActive() &&
        getUserRole() in ['university_admin', 'branch_admin', 'instructor'] &&
        getUserOrgId() == orgId
      );
    }

    // -------------------------------------------------------------------------
    // Course Design membership (Stage B). The optional users/{uid}.courseDesign
    // map is the ONLY source of Course Design authority; the content_lead /
    // content_designer roles are labels and grant nothing on their own.
    // Authority requires an active account, the same org as the content, an
    // eligible role, a well-formed membership, a matching responsibility and the
    // course in assignedCourseIds (['*'] = every course in the member's org,
    // only when granted explicitly and alone). Anything else fails closed.
    // -------------------------------------------------------------------------
    function isValidCourseDesignShape(cd) {
      return cd is map &&
        cd.keys().hasAll(['department', 'responsibilities', 'assignedCourseIds', 'assignedAt', 'assignedByUserId']) &&
        cd.keys().hasOnly(['department', 'responsibilities', 'assignedCourseIds', 'assignedAt', 'assignedByUserId']) &&
        cd.department == 'course_design' &&
        cd.responsibilities is list &&
        cd.responsibilities.size() >= 1 && cd.responsibilities.size() <= 5 &&
        cd.responsibilities.hasOnly(['lead', 'curriculum_architect', 'content_developer', 'assessment_designer', 'reviewer']) &&
        cd.responsibilities.toSet().size() == cd.responsibilities.size() &&
        cd.assignedCourseIds is list &&
        cd.assignedCourseIds.size() >= 1 && cd.assignedCourseIds.size() <= 50 &&
        cd.assignedCourseIds.toSet().size() == cd.assignedCourseIds.size() &&
        (cd.assignedCourseIds == ['*'] || !cd.assignedCourseIds.hasAny(['*'])) &&
        isIsoTimestamp(cd.assignedAt) &&
        cd.assignedByUserId is string && cd.assignedByUserId.size() > 0;
    }

    function hasCourseDesignAuthority(orgId, courseId, responsibilities) {
      return isAuthenticated() && isAccountActive() &&
        getUserOrgId() == orgId &&
        getUserRole() in ['content_lead', 'content_designer', 'instructor'] &&
        isValidCourseDesignShape(getUserData().get('courseDesign', null)) &&
        getUserData().courseDesign.responsibilities.hasAny(responsibilities) &&
        (getUserData().courseDesign.assignedCourseIds == ['*'] ||
          getUserData().courseDesign.assignedCourseIds.hasAny([courseId]));
    }

    // -------------------------------------------------------------------------
    // Stage C1: confidential quiz answer keys (lessons/{id}/answerKey/current).
    // Students can never read them; keyed quizzes are graded only by the
    // trusted server route (Admin SDK), which bypasses these rules.
    // -------------------------------------------------------------------------
    function answerKeyPath(lessonId) {
      return /databases/$(database)/documents/lessons/$(lessonId)/answerKey/current;
    }

    // A lesson "carries a quiz" when it has a non-empty answer key.
    function isQuizLesson(lessonId) {
      return exists(answerKeyPath(lessonId)) && get(answerKeyPath(lessonId)).data.items.size() > 0;
    }

    function canReadAnswerKey(k) {
      return isSuperAdmin() || canAuthorInOrg(k.orgId) ||
        hasCourseDesignAuthority(k.orgId, k.courseId, ['lead', 'curriculum_architect', 'content_developer', 'assessment_designer', 'reviewer']);
    }

    // Authors manage keys like lesson content; Course Design members only for
    // in-scope draft courses. Reviewers read only.
    function canManageAnswerKey(k) {
      return isSuperAdmin() || canAuthorInOrg(k.orgId) ||
        (hasCourseDesignAuthority(k.orgId, k.courseId, ['lead', 'curriculum_architect', 'content_developer', 'assessment_designer']) &&
          isCourseDraft(k.courseId));
    }

    // -------------------------------------------------------------------------
    // Stage C2: content review. Publication `status` and the `review` cycle
    // change only through the audited server route (Admin SDK), never from a
    // client — not even the Super Admin's (D3 is enforced there). Every client
    // write names its writer, and content is frozen while in review or approved.
    // -------------------------------------------------------------------------
    function reviewUnchanged() {
      return request.resource.data.get('review', null) == resource.data.get('review', null);
    }

    function statusUnchanged() {
      return request.resource.data.get('status', 'draft') == resource.data.get('status', 'draft');
    }

    function isContentFrozen(data) {
      return data.get('review', {}).get('state', 'none') in ['in_review', 'approved'];
    }

    function isNamedWriter() {
      return request.resource.data.get('lastEditedById', '') == request.auth.uid;
    }

    function isNewDraft() {
      return request.resource.data.get('status', 'draft') == 'draft' && !('review' in request.resource.data) && isNamedWriter();
    }

    // Stage C3: only drafts are edited in place. Published content is immutable;
    // a published lesson changes through its working revision.
    function isAllowedContentEdit() {
      return resource.data.get('status', 'draft') == 'draft' &&
        statusUnchanged() && reviewUnchanged() && !isContentFrozen(resource.data) && isNamedWriter();
    }

    // -------------------------------------------------------------------------
    // Stage C3: working revisions of published lessons and immutable versions.
    // -------------------------------------------------------------------------
    function revisionPath(lessonId) {
      return /databases/$(database)/documents/lessons/$(lessonId)/revisions/working;
    }

    function isRevisionFrozen(lessonId) {
      return exists(revisionPath(lessonId)) && isContentFrozen(get(revisionPath(lessonId)).data);
    }

    function isLessonStatus(lessonId, status) {
      return lessonExists(lessonId) && getLessonDoc(lessonId).data.get('status', 'draft') == status;
    }

    // Same authority as writing the lesson itself.
    function canEditLesson(lessonId) {
      let l = getLessonDoc(lessonId).data;
      return canAuthorInOrg(l.orgId) ||
        (hasCourseDesignAuthority(l.orgId, l.courseId, ['lead', 'curriculum_architect', 'content_developer']) && isCourseDraft(l.courseId));
    }

    function canReadLessonAsStaff(lessonId) {
      let l = getLessonDoc(lessonId).data;
      return isSuperAdmin() || canAuthorInOrg(l.orgId) ||
        hasCourseDesignAuthority(l.orgId, l.courseId, ['lead', 'curriculum_architect', 'content_developer', 'assessment_designer', 'reviewer']);
    }

    function isValidRevisionShape(d) {
      return d.keys().hasAll(['title', 'estimatedMinutes', 'blocks', 'baseVersion', 'lastEditedById', 'createdAt', 'updatedAt']) &&
        d.keys().hasOnly(['title', 'estimatedMinutes', 'blocks', 'baseVersion', 'review', 'lastEditedById', 'createdAt', 'updatedAt']) &&
        d.title is string && d.title.size() >= 2 && d.title.size() <= 160 &&
        d.estimatedMinutes is int && d.estimatedMinutes >= 1 && d.estimatedMinutes <= 600 &&
        d.blocks is list && d.blocks.size() <= 50 &&
        d.baseVersion is int && d.baseVersion >= 0 &&
        isIsoTimestamp(d.createdAt) && isIsoTimestamp(d.updatedAt);
    }

    function isCourseDraft(courseId) {
      let course = get(/databases/$(database)/documents/courses/$(courseId));
      return course != null && course.data.get('status', 'draft') == 'draft';
    }

    // Stage C5: Course Design membership and account status change only through
    // the audited server routes (/api/admin/course-design, /api/admin/account-status),
    // never with a client write — not even the Super Admin's.
    function courseDesignUnchanged() {
      return request.resource.data.get('courseDesign', null) == resource.data.get('courseDesign', null);
    }

    // Milestone G40/G50: role, branch, sign-in email and academy change only
    // through the audited POST /api/admin/account-profile.
    function accountIdentityUnchanged() {
      return request.resource.data.get('role', null) == resource.data.get('role', null) &&
        request.resource.data.get('branchId', null) == resource.data.get('branchId', null) &&
        request.resource.data.get('email', null) == resource.data.get('email', null) &&
        request.resource.data.get('orgId', null) == resource.data.get('orgId', null);
    }

    function accountStatusUnchanged() {
      return request.resource.data.get('status', 'active') == resource.data.get('status', 'active');
    }

    // Membership can't outlive eligibility: a role change to an ineligible role
    // needs the membership revoked first (server route, audited).
    function membershipStillEligible() {
      return !('courseDesign' in request.resource.data) ||
        request.resource.data.role in ['content_lead', 'content_designer', 'instructor'];
    }

    function courseBelongsToOrg(courseId, orgId) {
      let course = get(/databases/$(database)/documents/courses/$(courseId));
      return course != null && course.data.orgId == orgId;
    }

    function branchBelongsToOrg(branchId, orgId) {
      let branch = get(/databases/$(database)/documents/branches/$(branchId));
      return branch != null &&
        branch.data.orgId == orgId &&
        branch.data.get('status', 'active') == 'active';
    }

    function isAssignedInstructor(batchId) {
      let batch = get(/databases/$(database)/documents/batches/$(batchId));
      return batch != null && request.auth.uid in batch.data.get('instructorUserIds', []);
    }

    function isBatchInBranch(batchId, branchId) {
      let batch = get(/databases/$(database)/documents/batches/$(batchId));
      return batch != null && batch.data.branchId == branchId;
    }

    // Enrollment IDs are deterministic: {courseId}_{studentId}. This lets rules
    // look up "is the caller enrolled in this course" by path, and makes a
    // second enrollment record for the same student and course impossible.
    function callerEnrollment(courseId) {
      return get(/databases/$(database)/documents/enrollments/$(courseId + '_' + request.auth.uid));
    }

    // The stored studentId/courseId are re-checked because the concatenated ID is
    // ambiguous when IDs contain '_' (e.g. "crs" + "x_stu" == "crs_x" + "stu").
    function hasCourseAccess(courseId) {
      let enrollment = callerEnrollment(courseId);
      return enrollment != null &&
        enrollment.data.studentId == request.auth.uid &&
        enrollment.data.courseId == courseId &&
        enrollment.data.status in ['active', 'completed'];
    }

    function isEnrolledInBatch(courseId, batchId) {
      return hasCourseAccess(courseId) && callerEnrollment(courseId).data.batchId == batchId;
    }

    function isCoursePublished(courseId) {
      let course = get(/databases/$(database)/documents/courses/$(courseId));
      return course != null && course.data.get('status', '') == 'published';
    }

    function isIsoTimestamp(value) {
      return value is string &&
        value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$');
    }

    function isOptionalIsoTimestamp(data, field) {
      return !(field in data) || isIsoTimestamp(data[field]);
    }

    // A user's branch, when set, must be an active branch of the user's org.
    function isValidBranchAssignment(data) {
      return data.get('branchId', null) == null || branchBelongsToOrg(data.branchId, data.orgId);
    }

    function isValidProgressShape(data) {
      return data.keys().hasOnly([
          'id', 'orgId', 'courseId', 'moduleId', 'lessonId', 'studentId', 'batchId', 'status',
          'timeSpentSeconds', 'lastAccessedAt', 'completedAt', 'quiz', 'createdAt', 'updatedAt'
        ]) &&
        data.status in ['not_started', 'in_progress', 'completed'] &&
        data.timeSpentSeconds is int &&
        data.timeSpentSeconds >= 0 &&
        data.timeSpentSeconds <= 1000000 &&
        isOptionalIsoTimestamp(data, 'lastAccessedAt') &&
        isOptionalIsoTimestamp(data, 'completedAt') &&
        isOptionalIsoTimestamp(data, 'createdAt') &&
        isOptionalIsoTimestamp(data, 'updatedAt');
    }

    function canSubmitToAssignment(data) {
      let assignment = get(/databases/$(database)/documents/assignments/$(data.assignmentId));
      return assignment != null &&
        assignment.data.orgId == data.orgId &&
        assignment.data.get('status', '') == 'published' &&
        assignment.data.get('batchId', data.batchId) == data.batchId &&
        data.get('courseId', assignment.data.courseId) == assignment.data.courseId &&
        isEnrolledInBatch(assignment.data.courseId, data.batchId);
    }

    // -------------------------------------------------------------------------
    // Helper Functions: Stage 7 Daily Plans, Assignments & Submissions
    // -------------------------------------------------------------------------

    // Teaching authority over one batch: super admin, the org's university admin,
    // the batch branch's branch admin, or an instructor listed on the batch.
    function canTeachBatch(batchId) {
      let batch = get(/databases/$(database)/documents/batches/$(batchId));
      return batch != null && isAuthenticated() && isAccountActive() && (
        isSuperAdmin() ||
        isUniversityAdmin(batch.data.orgId) ||
        isBranchAdmin(batch.data.orgId, batch.data.branchId) ||
        (isInstructor(batch.data.orgId) && request.auth.uid in batch.data.get('instructorUserIds', []))
      );
    }

    function planMatchesOpenBatch(data) {
      let batch = get(/databases/$(database)/documents/batches/$(data.batchId));
      return batch.data.orgId == data.orgId &&
        batch.data.branchId == data.branchId &&
        batch.data.courseId == data.courseId &&
        batch.data.status in ['upcoming', 'in_progress'];
    }

    function isValidDailyPlan(data) {
      return data.keys().hasAll([
          'orgId', 'branchId', 'courseId', 'batchId', 'date', 'title', 'objectives',
          'lessonIds', 'learningDueAt', 'status', 'createdById'
        ]) &&
        data.keys().hasOnly([
          'id', 'orgId', 'branchId', 'courseId', 'batchId', 'date', 'title', 'objectives', 'lessonIds',
          'learningDueAt', 'assignmentId', 'status', 'publishedAt', 'createdById', 'createdAt', 'updatedAt'
        ]) &&
        data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 160 &&
        data.objectives is list && data.objectives.size() <= 10 &&
        data.lessonIds is list && data.lessonIds.size() <= 10 &&
        data.lessonIds.toSet().size() == data.lessonIds.size() &&
        isIsoTimestamp(data.learningDueAt) &&
        data.status in ['draft', 'published', 'archived'] &&
        isOptionalIsoTimestamp(data, 'publishedAt') &&
        isOptionalIsoTimestamp(data, 'createdAt') &&
        isOptionalIsoTimestamp(data, 'updatedAt') &&
        (!('assignmentId' in data) || data.assignmentId == data.batchId + '_' + data.date);
    }

    function isValidDailyAssignment(data) {
      return data.keys().hasAll([
          'orgId', 'courseId', 'batchId', 'planId', 'title', 'description', 'submissionType',
          'totalPoints', 'deadline', 'status', 'createdById'
        ]) &&
        data.keys().hasOnly([
          'id', 'orgId', 'courseId', 'batchId', 'planId', 'moduleId', 'lessonId', 'title', 'description',
          'submissionType', 'totalPoints', 'rubric', 'deadline', 'status', 'createdById', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 160 &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 20000 &&
        data.submissionType in ['text', 'code', 'text_and_code'] &&
        data.totalPoints is int && data.totalPoints >= 1 && data.totalPoints <= 1000 &&
        (!('rubric' in data) || (data.rubric is list && data.rubric.size() <= 20)) &&
        isIsoTimestamp(data.deadline) &&
        data.status in ['draft', 'published', 'archived'] &&
        isOptionalIsoTimestamp(data, 'createdAt') &&
        isOptionalIsoTimestamp(data, 'updatedAt');
    }

    // A daily assignment's ID is its plan's ID, and the plan must share its batch.
    function assignmentMatchesPlan(data, assignmentId) {
      let plan = get(/databases/$(database)/documents/dailyPlans/$(data.planId));
      return assignmentId == data.planId &&
        plan != null &&
        plan.data.batchId == data.batchId &&
        plan.data.courseId == data.courseId &&
        plan.data.orgId == data.orgId;
    }

    // -------------------------------------------------------------------------
    // Helper Functions: Stage 8 Weekly Timetable, Revisions & Approval
    // -------------------------------------------------------------------------

    function canManageBatchTimetable(batchId) {
      let batch = get(/databases/$(database)/documents/batches/$(batchId));
      return batch != null && isAuthenticated() && isAccountActive() && (
        isSuperAdmin() ||
        isUniversityAdmin(batch.data.orgId) ||
        isBranchAdmin(batch.data.orgId, batch.data.branchId)
      );
    }

    function isValidTimetableRoot(data) {
      return data.keys().hasAll([
          'id', 'orgId', 'branchId', 'batchId', 'courseId', 'weekStartDate', 'weekEndDate',
          'currentRevisionId', 'latestStatus'
        ]) &&
        data.keys().hasOnly([
          'id', 'orgId', 'branchId', 'batchId', 'courseId', 'weekStartDate', 'weekEndDate',
          'activeRevisionId', 'currentRevisionId', 'latestStatus', 'createdAt', 'updatedAt'
        ]) &&
        data.weekStartDate is string && data.weekStartDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.weekEndDate is string && data.weekEndDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.latestStatus in ['draft', 'submitted', 'changes_requested', 'approved'] &&
        (!('activeRevisionId' in data) || data.activeRevisionId == null || data.activeRevisionId is string) &&
        isOptionalIsoTimestamp(data, 'createdAt') &&
        isOptionalIsoTimestamp(data, 'updatedAt');
    }

    function isValidTimetableRevision(data) {
      return data.keys().hasAll([
          'id', 'timetableId', 'revisionNumber', 'orgId', 'branchId', 'batchId', 'courseId',
          'weekStartDate', 'weekEndDate', 'status', 'days', 'createdById'
        ]) &&
        data.keys().hasOnly([
          'id', 'timetableId', 'revisionNumber', 'orgId', 'branchId', 'batchId', 'courseId',
          'weekStartDate', 'weekEndDate', 'status', 'days', 'createdById', 'submittedById',
          'submittedAt', 'reviewedById', 'reviewedAt', 'reviewComment', 'createdAt', 'updatedAt'
        ]) &&
        data.revisionNumber is int && data.revisionNumber >= 1 &&
        data.status in ['draft', 'submitted', 'changes_requested', 'approved'] &&
        data.days is map &&
        data.days.keys().hasAll(['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday']) &&
        isOptionalIsoTimestamp(data, 'submittedAt') &&
        isOptionalIsoTimestamp(data, 'reviewedAt') &&
        isOptionalIsoTimestamp(data, 'createdAt') &&
        isOptionalIsoTimestamp(data, 'updatedAt');
    }

    function isValidTimetableAuditLog(data) {
      return data.keys().hasAll([
          'id', 'timetableId', 'revisionId', 'fromStatus', 'toStatus', 'action',
          'actorUid', 'actorRole', 'timestamp'
        ]) &&
        data.keys().hasOnly([
          'id', 'timetableId', 'revisionId', 'fromStatus', 'toStatus', 'action',
          'actorUid', 'actorRole', 'comment', 'timestamp'
        ]) &&
        data.action in ['create_draft', 'submit', 'request_changes', 'resubmit', 'approve'] &&
        data.fromStatus in ['draft', 'submitted', 'changes_requested', 'approved'] &&
        data.toStatus in ['draft', 'submitted', 'changes_requested', 'approved'] &&
        data.actorUid == request.auth.uid &&
        data.timestamp == request.time;
    }

    function isValidSubmissionShape(data) {
      return data.keys().hasOnly([
          'id', 'orgId', 'assignmentId', 'batchId', 'courseId', 'studentId', 'textAnswer', 'codeContent',
          'submissionUrl', 'notes', 'status', 'attemptCount', 'submittedAt', 'score', 'feedback',
          'gradedByUserId', 'gradedAt', 'createdAt', 'updatedAt'
        ]) &&
        (!('textAnswer' in data) || (data.textAnswer is string && data.textAnswer.size() <= 20000)) &&
        (!('codeContent' in data) || (data.codeContent is string && data.codeContent.size() <= 100000)) &&
        (!('submissionUrl' in data) || (data.submissionUrl is string && data.submissionUrl.size() <= 500 && data.submissionUrl.matches('^https://.*'))) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
        data.attemptCount is int;
    }

    function canReviewSubmission(data) {
      return isSuperAdmin() ||
        isUniversityAdmin(data.orgId) ||
        (
          isScopedBranchAdminRole() &&
          getUserOrgId() == data.orgId &&
          isBatchInBranch(data.batchId, getUserBranchId())
        ) ||
        (isInstructor(data.orgId) && isAssignedInstructor(data.batchId));
    }

    // An instructor may be assigned only if they are an active instructor of the
    // same org, and either unscoped to a branch or scoped to the batch's branch.
    function isAssignableInstructor(uid, orgId, branchId) {
      let instructor = get(/databases/$(database)/documents/users/$(uid));
      return instructor != null &&
        instructor.data.role == 'instructor' &&
        instructor.data.orgId == orgId &&
        instructor.data.get('status', 'active') == 'active' &&
        instructor.data.get('branchId', null) in [branchId, null];
    }

    // Rules have no loops, so the list is capped at 5 and checked by index.
    function validInstructorList(ids, orgId, branchId) {
      return (ids.size() < 1 || isAssignableInstructor(ids[0], orgId, branchId)) &&
        (ids.size() < 2 || isAssignableInstructor(ids[1], orgId, branchId)) &&
        (ids.size() < 3 || isAssignableInstructor(ids[2], orgId, branchId)) &&
        (ids.size() < 4 || isAssignableInstructor(ids[3], orgId, branchId)) &&
        (ids.size() < 5 || isAssignableInstructor(ids[4], orgId, branchId));
    }

    function isValidBatchShape(data) {
      return data.keys().hasAll(['orgId', 'branchId', 'courseId', 'name', 'code', 'instructorUserIds', 'startDate', 'status']) &&
        data.keys().hasOnly([
          'id', 'orgId', 'branchId', 'courseId', 'name', 'code', 'instructorUserIds', 'instructorNames',
          'startDate', 'endDate', 'maxStudents', 'activeEnrollmentCount', 'status', 'createdById', 'createdAt', 'updatedAt'
        ]) &&
        (!('activeEnrollmentCount' in data) || (data.activeEnrollmentCount is int && data.activeEnrollmentCount >= 0)) &&
        // Display names shown to students (D5): one short string per instructor, nothing else.
        (!('instructorNames' in data) || (
          data.instructorNames is list &&
          data.instructorNames.size() == data.instructorUserIds.size() &&
          (data.instructorNames.size() < 1 || (data.instructorNames[0] is string && data.instructorNames[0].size() <= 100)) &&
          (data.instructorNames.size() < 2 || (data.instructorNames[1] is string && data.instructorNames[1].size() <= 100)) &&
          (data.instructorNames.size() < 3 || (data.instructorNames[2] is string && data.instructorNames[2].size() <= 100)) &&
          (data.instructorNames.size() < 4 || (data.instructorNames[3] is string && data.instructorNames[3].size() <= 100)) &&
          (data.instructorNames.size() < 5 || (data.instructorNames[4] is string && data.instructorNames[4].size() <= 100))
        )) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 160 &&
        data.code is string && data.code.size() >= 2 && data.code.size() <= 30 &&
        isIsoTimestamp(data.startDate) &&
        (!('endDate' in data) || (isIsoTimestamp(data.endDate) && data.endDate >= data.startDate)) &&
        (!('maxStudents' in data) || (data.maxStudents is int && data.maxStudents >= 1 && data.maxStudents <= 200)) &&
        data.status in ['upcoming', 'in_progress', 'completed', 'cancelled', 'archived'] &&
        data.instructorUserIds is list &&
        data.instructorUserIds.size() <= 5 &&
        data.instructorUserIds.toSet().size() == data.instructorUserIds.size();
    }

    function isValidEnrollmentShape(data) {
      return data.keys().hasAll(['orgId', 'branchId', 'courseId', 'batchId', 'studentId', 'status', 'enrolledAt']) &&
        data.keys().hasOnly([
          'id', 'orgId', 'branchId', 'courseId', 'batchId', 'studentId', 'status',
          'enrolledAt', 'completedAt', 'createdAt', 'updatedAt',
          'studentDisplayName', 'studentEmail', 'enrolledById'
        ]) &&
        data.status in ['active', 'completed', 'dropped', 'suspended'] &&
        isIsoTimestamp(data.enrolledAt) &&
        isOptionalIsoTimestamp(data, 'completedAt') &&
        (!('studentDisplayName' in data) || (data.studentDisplayName is string && data.studentDisplayName.size() <= 100)) &&
        (!('studentEmail' in data) || (data.studentEmail is string && data.studentEmail.size() <= 255));
    }

    // Batch capacity (owner decision D2). On a batch with maxStudents, every
    // enrollment write that adds or removes an active seat must move the batch's
    // activeEnrollmentCount by exactly that amount in the same atomic write, and
    // never past maxStudents. Concurrent enrollments therefore serialise on the
    // batch document instead of both passing a client-side check.
    function seatsOf(batchDoc) {
      return batchDoc.data.get('activeEnrollmentCount', 0);
    }

    function seatChangeOk(batchId, delta) {
      let before = get(/databases/$(database)/documents/batches/$(batchId));
      let after = getAfter(/databases/$(database)/documents/batches/$(batchId));
      return !('maxStudents' in before.data) || (
        seatsOf(after) == seatsOf(before) + delta &&
        (delta <= 0 || seatsOf(after) <= after.data.maxStudents)
      );
    }

    function seatTransitionOk(batchId, wasActive, nowActive) {
      return (wasActive && nowActive && seatChangeOk(batchId, 0)) ||
        (!wasActive && nowActive && seatChangeOk(batchId, 1)) ||
        (wasActive && !nowActive && seatChangeOk(batchId, -1)) ||
        (!wasActive && !nowActive && seatChangeOk(batchId, 0));
    }

    // Verifies every relationship an active enrollment depends on: the batch is
    // open and matches org/branch/course, and the student is an active student
    // of that org and branch. Denormalized roster fields must match the profile.
    function isValidEnrollmentTarget(data) {
      let batch = get(/databases/$(database)/documents/batches/$(data.batchId));
      let student = get(/databases/$(database)/documents/users/$(data.studentId));
      return batch != null && student != null &&
        batch.data.orgId == data.orgId &&
        batch.data.branchId == data.branchId &&
        batch.data.courseId == data.courseId &&
        batch.data.status in ['upcoming', 'in_progress'] &&
        student.data.role == 'student' &&
        student.data.orgId == data.orgId &&
        student.data.get('branchId', null) == data.branchId &&
        student.data.get('status', 'active') == 'active' &&
        (!('studentDisplayName' in data) || data.studentDisplayName == student.data.get('displayName', '')) &&
        (!('studentEmail' in data) || data.studentEmail == student.data.get('email', ''));
    }

    // Default deny by default
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // 1. /organizations/{orgId}
    // -------------------------------------------------------------------------
    match /organizations/{orgId} {
      // Super admin can read/write any organization.
      // Active members can read their own organization's profile.
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (isAccountActive() && getUserOrgId() == orgId)
      );
      allow write: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // 2. /branches/{branchId}
    // -------------------------------------------------------------------------
    match /branches/{branchId} {
      // Active members of the org can read branches.
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (isAccountActive() && getUserOrgId() == resource.data.orgId)
      );

      allow create: if isSuperAdmin() || (
        isAuthenticated() && isAccountActive() &&
        getUserRole() == 'university_admin' &&
        getUserOrgId() == request.resource.data.orgId
      );

      allow update: if isSuperAdmin() || (
        isAuthenticated() && isAccountActive() && (
          (getUserRole() == 'university_admin' && getUserOrgId() == resource.data.orgId && request.resource.data.orgId == resource.data.orgId) ||
          (getUserRole() == 'branch_admin' && getUserOrgId() == resource.data.orgId && getUserBranchId() == branchId && request.resource.data.orgId == resource.data.orgId)
        )
      );

      allow delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // 3. /users/{userId}
    // Document ID MUST be the Firebase Auth UID
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (isAccountActive() && getUserRole() == 'university_admin' && getUserOrgId() == resource.data.orgId) ||
        (isAccountActive() && isScopedBranchAdminRole() && getUserOrgId() == resource.data.orgId && getUserBranchId() == resource.data.get('branchId', ''))
      );

      // Self sign-up only. Every administrator-created account (staff, students,
      // University Admins) is created by the audited server route
      // POST /api/admin/accounts (milestone G37/G50), never by a client write.
      allow create: if isAuthenticated() && (
        (
          // SELF REGISTRATION: User can only create their own record (userId == auth.uid)
          // SECURITY INVARIANT: Role MUST be 'student' and status MUST be
          // 'pending_verification'. A self-registered profile grants no access
          // until an administrator of that org/branch activates it.
          request.auth.uid == userId &&
          request.resource.data.role == 'student' &&
          request.resource.data.get('status', '') == 'pending_verification' &&
          request.resource.data.email is string &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() <= 100 &&
          request.resource.data.orgId is string &&
          request.resource.data.orgId.size() <= 128 &&
          !('courseDesign' in request.resource.data)
        )
      );

      // Updates
      allow update: if isAuthenticated() && courseDesignUnchanged() && accountStatusUnchanged() && accountIdentityUnchanged() && membershipStillEligible() && (
        isSuperAdmin() ||
        (
          // Self update: presentation fields only. role, status, orgId, branchId and
          // email (copied into enrollment roster snapshots) are administrator-managed.
          isAccountActive() &&
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'photoURL', 'phoneNumber', 'updatedAt']) &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() <= 100
        ) ||
        (
          // University admin managing branch admins, instructors and students in their
          // org. Peer university admins and role promotion beyond these are super-admin only.
          isAccountActive() && getUserRole() == 'university_admin' &&
          request.auth.uid != userId &&
          getUserOrgId() == resource.data.orgId &&
          request.resource.data.orgId == resource.data.orgId &&
          resource.data.role in ['branch_admin', 'instructor', 'student'] &&
          request.resource.data.role in ['branch_admin', 'instructor', 'student'] &&
          courseDesignUnchanged() &&
          (
            request.resource.data.get('branchId', null) == resource.data.get('branchId', null) ||
            isValidBranchAssignment(request.resource.data)
          )
        ) ||
        (
          // Branch admin modifying a student/instructor in their branch (cannot modify own record via this branch rule)
          isAccountActive() && isScopedBranchAdminRole() &&
          request.auth.uid != userId &&
          getUserOrgId() == resource.data.orgId &&
          getUserBranchId() == resource.data.get('branchId', '') &&
          request.resource.data.orgId == resource.data.orgId &&
          request.resource.data.branchId == resource.data.get('branchId', '') &&
          resource.data.role in ['instructor', 'student'] &&
          request.resource.data.role in ['instructor', 'student'] &&
          courseDesignUnchanged()
        )
      );

      allow delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // 4. /courses/{courseId}
    // Students read a published course only through an active/completed enrollment.
    // -------------------------------------------------------------------------
    match /courses/{courseId} {
      allow read: if isAuthenticated() && isAccountActive() && (
        isSuperAdmin() ||
        (getUserOrgId() == resource.data.orgId && (
          getUserRole() in ['university_admin', 'branch_admin', 'instructor'] ||
          (getUserRole() == 'student' && resource.data.get('status', '') == 'published' && hasCourseAccess(courseId))
        )) ||
        // Course Design members read only the courses in their scope.
        hasCourseDesignAuthority(resource.data.orgId, courseId, ['lead', 'curriculum_architect', 'content_developer', 'assessment_designer', 'reviewer'])
      );

      // Course governance (owner decision D3): courses are shared by every
      // branch, so only the Super Admin publishes, unpublishes, archives or
      // deletes them — through the audited review route (Stage C2), never with
      // a client write. Other staff create drafts and edit a course only while it
      // is still a draft. Course Design members with the lead or
      // curriculum_architect responsibility may do the same for in-scope
      // courses. createdById must be the caller; it and createdAt are immutable.
      allow create: if (isSuperAdmin() || (
        (
          (isAuthenticated() && isAccountActive() &&
            (getUserRole() in ['university_admin', 'branch_admin', 'instructor']) &&
            getUserOrgId() == request.resource.data.orgId) ||
          hasCourseDesignAuthority(request.resource.data.orgId, courseId, ['lead', 'curriculum_architect'])
        ) &&
        request.resource.data.get('createdById', request.auth.uid) == request.auth.uid
      )) && isNewDraft();

      allow update: if (isSuperAdmin() || (
        (
          (isAuthenticated() && isAccountActive() &&
            (getUserRole() in ['university_admin', 'branch_admin', 'instructor']) &&
            getUserOrgId() == resource.data.orgId) ||
          hasCourseDesignAuthority(resource.data.orgId, courseId, ['lead', 'curriculum_architect'])
        ) &&
        resource.data.get('status', 'draft') == 'draft' &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.get('createdById', null) == resource.data.get('createdById', null) &&
        request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
      )) && isAllowedContentEdit();

      allow delete: if isSuperAdmin();

      // Stage C3: immutable published snapshots of course details (server-written).
      match /versions/{versionId} {
        allow read: if isAuthenticated() && isAccountActive() && (
          isSuperAdmin() || canAuthorInOrg(resource.data.orgId) ||
          hasCourseDesignAuthority(resource.data.orgId, resource.data.courseId, ['lead', 'curriculum_architect', 'content_developer', 'assessment_designer', 'reviewer'])
        );
        allow write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // 5. /batches/{batchId}
    // orgId, branchId, courseId, createdById and createdAt are immutable.
    // Archiving is a status change ('archived'); hard delete is super admin only.
    // -------------------------------------------------------------------------
    match /batches/{batchId} {
      allow read: if isAuthenticated() && isAccountActive() && (
        isSuperAdmin() ||
        isUniversityAdmin(resource.data.orgId) ||
        isBranchAdmin(resource.data.orgId, resource.data.branchId) ||
        (isInstructor(resource.data.orgId) && request.auth.uid in resource.data.instructorUserIds) ||
        (isStudent(resource.data.orgId) && isEnrolledInBatch(resource.data.courseId, batchId))
      );

      allow create: if canManageBranch(request.resource.data.orgId, request.resource.data.branchId) &&
        isValidBatchShape(request.resource.data) &&
        request.resource.data.status != 'archived' &&
        request.resource.data.get('createdById', request.auth.uid) == request.auth.uid &&
        branchBelongsToOrg(request.resource.data.branchId, request.resource.data.orgId) &&
        courseBelongsToOrg(request.resource.data.courseId, request.resource.data.orgId) &&
        validInstructorList(request.resource.data.instructorUserIds, request.resource.data.orgId, request.resource.data.branchId);

      allow update: if canManageBranch(resource.data.orgId, resource.data.branchId) &&
        isValidBatchShape(request.resource.data) &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.branchId == resource.data.branchId &&
        request.resource.data.courseId == resource.data.courseId &&
        request.resource.data.get('createdById', null) == resource.data.get('createdById', null) &&
        request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null) &&
        (
          request.resource.data.instructorUserIds == resource.data.instructorUserIds ||
          validInstructorList(request.resource.data.instructorUserIds, resource.data.orgId, resource.data.branchId)
        );

      allow delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // 6. /modules/{moduleId}
    // -------------------------------------------------------------------------
    match /modules/{moduleId} {
      allow read: if isAuthenticated() && isAccountActive() && (
        isSuperAdmin() ||
        (getUserOrgId() == resource.data.orgId && (
          getUserRole() in ['university_admin', 'branch_admin', 'instructor'] ||
          (
            getUserRole() == 'student' &&
            resource.data.get('status', '') == 'published' &&
            isCoursePublished(resource.data.courseId) &&
            hasCourseAccess(resource.data.courseId)
          )
        )) ||
        hasCourseDesignAuthority(resource.data.orgId, resource.data.courseId, ['lead', 'curriculum_architect', 'content_developer', 'assessment_designer', 'reviewer'])
      );

      // Tenant ownership is checked against the EXISTING document on update so a
      // foreign-org author cannot take over a record by relabelling its orgId.
      // Modules are structure, not a release step; lesson and course status gate visibility.
      // Course Design members (lead / curriculum_architect) structure in-scope draft courses only.
      allow create: if (
          canAuthorInOrg(request.resource.data.orgId) ||
          (hasCourseDesignAuthority(request.resource.data.orgId, request.resource.data.courseId, ['lead', 'curriculum_architect']) &&
            isCourseDraft(request.resource.data.courseId))
        ) &&
        courseBelongsToOrg(request.resource.data.courseId, request.resource.data.orgId);

      allow update: if (
          canAuthorInOrg(resource.data.orgId) ||
          (hasCourseDesignAuthority(resource.data.orgId, resource.data.courseId, ['lead', 'curriculum_architect']) &&
            isCourseDraft(resource.data.courseId))
        ) &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.courseId == resource.data.courseId;

      allow delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // 7. /lessons/{lessonId} (Live Books)
    // -------------------------------------------------------------------------
    match /lessons/{lessonId} {
      allow read: if isAuthenticated() && isAccountActive() && (
        isSuperAdmin() ||
        (getUserOrgId() == resource.data.orgId && (
          getUserRole() in ['university_admin', 'branch_admin', 'instructor'] ||
          (
            getUserRole() == 'student' &&
            resource.data.get('status', '') == 'published' &&
            isCoursePublished(resource.data.courseId) &&
            hasCourseAccess(resource.data.courseId)
          )
        )) ||
        hasCourseDesignAuthority(resource.data.orgId, resource.data.courseId, ['lead', 'curriculum_architect', 'content_developer', 'assessment_designer', 'reviewer'])
      );

      // Staff write content; status changes only through the audited review
      // route, where only the Super Admin publishes (D3, Stage C2). Course
      // Design members (lead / curriculum_architect / content_developer) write
      // lessons of in-scope draft courses only, and never change status.
      allow create: if (
          canAuthorInOrg(request.resource.data.orgId) ||
          (hasCourseDesignAuthority(request.resource.data.orgId, request.resource.data.courseId, ['lead', 'curriculum_architect', 'content_developer']) &&
            isCourseDraft(request.resource.data.courseId))
        ) &&
        courseBelongsToOrg(request.resource.data.courseId, request.resource.data.orgId) &&
        isNewDraft();

      allow update: if (
          canAuthorInOrg(resource.data.orgId) ||
          (hasCourseDesignAuthority(resource.data.orgId, resource.data.courseId, ['lead', 'curriculum_architect', 'content_developer']) &&
            isCourseDraft(resource.data.courseId))
        ) &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.courseId == resource.data.courseId &&
        isAllowedContentEdit();

      allow delete: if isSuperAdmin();

      match /answerKey/{keyId} {
        // A key that doesn't exist yet reveals nothing; lesson staff may confirm that
        // (the Block Studio loads it for every lesson). Students never read keys.
        allow read: if keyId in ['current', 'working'] && isAuthenticated() && isAccountActive() && (
          resource == null ? canReadLessonAsStaff(lessonId) : canReadAnswerKey(resource.data)
        );
        // Milestone G50: every answer-key change (full Block Studio, assessment-only
        // editing, migration, publishing) is made by an audited server route; no
        // client creates or changes a key. The routes validate keys with
        // lessonAnswerKeySchema (src/types/validation.ts).
        allow create, update: if false;
        allow delete: if isSuperAdmin() || (keyId == 'working' && isAuthenticated() && isAccountActive() &&
          canManageAnswerKey(resource.data) && !isRevisionFrozen(lessonId));
      }

      // Stage C3: the working copy of a published lesson. Never readable by
      // students; it follows the same review cycle and freeze as a draft.
      match /revisions/{revisionId} {
        allow read: if revisionId == 'working' && isAuthenticated() && isAccountActive() && canReadLessonAsStaff(lessonId);
        allow create: if revisionId == 'working' && isAuthenticated() && isAccountActive() &&
          isLessonStatus(lessonId, 'published') && canEditLesson(lessonId) &&
          isValidRevisionShape(request.resource.data) && !('review' in request.resource.data) && isNamedWriter();
        allow update: if revisionId == 'working' && isAuthenticated() && isAccountActive() &&
          isLessonStatus(lessonId, 'published') && canEditLesson(lessonId) &&
          isValidRevisionShape(request.resource.data) && reviewUnchanged() && !isContentFrozen(resource.data) && isNamedWriter();
        allow delete: if isSuperAdmin() || (isAuthenticated() && isAccountActive() && canEditLesson(lessonId) && !isContentFrozen(resource.data));
      }

      // Stage C4: original blocks kept by the legacy quiz migration for recovery.
      // They contain answers, so no client may read or write them.
      match /legacyBackup/{backupId} {
        allow read, write: if false;
      }

      // Stage C3: immutable published snapshots, written only by the review route.
      match /versions/{versionId} {
        allow read: if isAuthenticated() && isAccountActive() && canReadAnswerKey(resource.data);
        allow write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // Stage C2: /auditLog/{auditId} — review, publication and assessment
    // decisions. Written only by the trusted server route in the same
    // transaction as the change it records, with a Firestore server timestamp.
    // Never written, changed or deleted by a client.
    // -------------------------------------------------------------------------
    // Content entries carry a courseId; account entries (Stage C5: membership and
    // status changes) have courseId null and are visible only to the Super Admin
    // and the University Admin of that org.
    match /auditLog/{auditId} {
      // University Admins see every entry of their academy (the audit log viewer,
      // milestone G44); other authors see content entries only.
      allow read: if isAuthenticated() && isAccountActive() && (
        isSuperAdmin() ||
        isUniversityAdmin(resource.data.orgId) ||
        (resource.data.courseId is string && (
          canAuthorInOrg(resource.data.orgId) ||
          hasCourseDesignAuthority(resource.data.orgId, resource.data.courseId, ['lead', 'curriculum_architect', 'content_developer', 'assessment_designer', 'reviewer'])
        ))
      );
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Milestone G46: /notifications/{id} — in-app notifications. Trusted server
    // routes create most of them (Admin SDK). The one client-created kind is a
    // grading notice, allowed only in the same write that grades or returns
    // that student's submission, by someone who teaches its batch. Recipients
    // read their own and may only mark them read; nobody deletes them.
    // -------------------------------------------------------------------------
    function isGradedInThisWrite(n) {
      let after = getAfter(/databases/$(database)/documents/submissions/$(n.sourceId));
      return after != null &&
        after.data.studentId == n.userId &&
        after.data.orgId == n.orgId &&
        after.data.get('gradedByUserId', '') == request.auth.uid &&
        after.data.get('gradedAt', null) == request.time &&
        after.data.status == (n.type == 'submission_graded' ? 'graded' : 'resubmit_requested') &&
        canTeachBatch(after.data.batchId);
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && isAccountActive() &&
        resource.data.userId == request.auth.uid && resource.data.orgId == getUserOrgId();

      allow create: if isAuthenticated() && isAccountActive() &&
        request.resource.data.keys().hasAll(['orgId', 'userId', 'type', 'title', 'body', 'sourceId', 'read', 'createdAt']) &&
        request.resource.data.keys().hasOnly(['orgId', 'userId', 'type', 'title', 'body', 'link', 'sourceId', 'read', 'createdAt']) &&
        request.resource.data.type in ['submission_graded', 'correction_requested'] &&
        request.resource.data.read == false &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.title is string && request.resource.data.title.size() <= 120 &&
        request.resource.data.body is string && request.resource.data.body.size() <= 500 &&
        request.resource.data.get('link', '/') is string && request.resource.data.get('link', '/').matches('^/[^/].*|^/$') &&
        request.resource.data.sourceId is string &&
        isGradedInThisWrite(request.resource.data);

      allow update: if isAuthenticated() && isAccountActive() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']) &&
        request.resource.data.read == true &&
        request.resource.data.readAt == request.time;

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // 8. /enrollments/{enrollmentId}
    // Document ID MUST be {courseId}_{studentId}. orgId, studentId, courseId,
    // createdAt and enrolledById are immutable. Moving to another batch of the
    // same course is a re-enrollment and must pass full target validation.
    // -------------------------------------------------------------------------
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && isAccountActive() && (
        isSuperAdmin() ||
        isUniversityAdmin(resource.data.orgId) ||
        isBranchAdmin(resource.data.orgId, resource.data.branchId) ||
        (isInstructor(resource.data.orgId) && isAssignedInstructor(resource.data.batchId)) ||
        (isStudent(resource.data.orgId) && resource.data.studentId == request.auth.uid)
      );

      allow create: if canManageBranch(request.resource.data.orgId, request.resource.data.branchId) &&
        enrollmentId == request.resource.data.courseId + '_' + request.resource.data.studentId &&
        isValidEnrollmentShape(request.resource.data) &&
        request.resource.data.status == 'active' &&
        request.resource.data.get('enrolledById', request.auth.uid) == request.auth.uid &&
        isValidEnrollmentTarget(request.resource.data) &&
        seatChangeOk(request.resource.data.batchId, 1);

      allow update: if canManageBranch(resource.data.orgId, resource.data.branchId) &&
        canManageBranch(request.resource.data.orgId, request.resource.data.branchId) &&
        isValidEnrollmentShape(request.resource.data) &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.courseId == resource.data.courseId &&
        request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null) &&
        request.resource.data.get('enrolledById', null) == resource.data.get('enrolledById', null) &&
        (
          (
            // Status change within the same batch; reactivation re-validates.
            request.resource.data.batchId == resource.data.batchId &&
            request.resource.data.branchId == resource.data.branchId &&
            (
              request.resource.data.status != 'active' ||
              resource.data.status == 'active' ||
              isValidEnrollmentTarget(request.resource.data)
            ) &&
            seatTransitionOk(resource.data.batchId, resource.data.status == 'active', request.resource.data.status == 'active')
          ) ||
          (
            // Re-enrollment into another batch of the same course.
            request.resource.data.batchId != resource.data.batchId &&
            request.resource.data.status == 'active' &&
            isValidEnrollmentTarget(request.resource.data) &&
            seatChangeOk(request.resource.data.batchId, 1) &&
            seatTransitionOk(resource.data.batchId, resource.data.status == 'active', false)
          )
        );

      allow delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // 9. /progress/{progressId}
    // Progress carries the student's enrollment batchId so instructors and branch
    // admins can be scoped to their batches. Students may only write progress
    // for courses they are enrolled in, tagged with their enrollment batch.
    // -------------------------------------------------------------------------
    match /progress/{progressId} {
      allow read: if isAuthenticated() && isAccountActive() && (
        isSuperAdmin() ||
        (getUserOrgId() == resource.data.orgId && resource.data.studentId == request.auth.uid) ||
        isUniversityAdmin(resource.data.orgId) ||
        (
          isScopedBranchAdminRole() &&
          getUserOrgId() == resource.data.orgId &&
          isBatchInBranch(resource.data.batchId, getUserBranchId())
        ) ||
        (isInstructor(resource.data.orgId) && isAssignedInstructor(resource.data.batchId))
      );

      allow create: if isAuthenticated() && isAccountActive() && (
        isSuperAdmin() ||
        (
          getUserOrgId() == request.resource.data.orgId &&
          request.resource.data.studentId == request.auth.uid &&
          isValidProgressShape(request.resource.data) &&
          isLessonPublishedAndInOrg(request.resource.data.lessonId, getUserOrgId()) &&
          getLessonDoc(request.resource.data.lessonId).data.courseId == request.resource.data.courseId &&
          getLessonDoc(request.resource.data.lessonId).data.moduleId == request.resource.data.moduleId &&
          isEnrolledInBatch(request.resource.data.courseId, request.resource.data.batchId) &&
          // Quiz results are written only by the grading server; quiz lessons
          // are completed only by passing there.
          !('quiz' in request.resource.data) &&
          (request.resource.data.status != 'completed' || !isQuizLesson(request.resource.data.lessonId))
        )
      );

      allow update: if isAuthenticated() && isAccountActive() && (
        isSuperAdmin() ||
        (
          getUserOrgId() == resource.data.orgId &&
          resource.data.studentId == request.auth.uid &&
          request.resource.data.studentId == request.auth.uid &&
          request.resource.data.orgId == resource.data.orgId &&
          request.resource.data.courseId == resource.data.courseId &&
          request.resource.data.moduleId == resource.data.moduleId &&
          request.resource.data.lessonId == resource.data.lessonId &&
          isValidProgressShape(request.resource.data) &&
          // Time only accumulates (bounded per write) and completion is not reversible.
          request.resource.data.timeSpentSeconds >= resource.data.get('timeSpentSeconds', 0) &&
          request.resource.data.timeSpentSeconds <= resource.data.get('timeSpentSeconds', 0) + 86400 &&
          (resource.data.get('status', '') != 'completed' || request.resource.data.status == 'completed') &&
          request.resource.data.get('quiz', null) == resource.data.get('quiz', null) &&
          (request.resource.data.status != 'completed' || resource.data.get('status', '') == 'completed' || !isQuizLesson(resource.data.lessonId)) &&
          hasCourseAccess(resource.data.courseId) &&
          (
            // batchId may only stay as-is or be (re)tagged to the current enrollment batch.
            request.resource.data.get('batchId', null) == resource.data.get('batchId', null) ||
            isEnrolledInBatch(resource.data.courseId, request.resource.data.batchId)
          )
        )
      );

      allow delete: if isSuperAdmin();

      // Immutable attempt history, written only by the grading server.
      match /quizAttempts/{attemptId} {
        allow read: if isAuthenticated() && isAccountActive() && (
          isSuperAdmin() ||
          (getUserOrgId() == resource.data.orgId && resource.data.studentId == request.auth.uid) ||
          isUniversityAdmin(resource.data.orgId) ||
          (isScopedBranchAdminRole() && getUserOrgId() == resource.data.orgId && isBatchInBranch(resource.data.batchId, getUserBranchId())) ||
          (isInstructor(resource.data.orgId) && isAssignedInstructor(resource.data.batchId))
        );
        allow write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // 10. /assignments/{assignmentId}
    // Stage 7: assignments are daily assignments scoped to one batch and one
    // daily plan (ID == planId). Legacy course-level assignments without a
    // batchId stay readable but are no longer writable by non-super-admins.
    // -------------------------------------------------------------------------
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated() && isAccountActive() && (
        isSuperAdmin() ||
        canTeachBatch(resource.data.batchId) ||
        (
          resource.data.get('batchId', null) == null &&
          getUserOrgId() == resource.data.orgId &&
          getUserRole() in ['university_admin', 'branch_admin', 'instructor']
        ) ||
        (
          getUserRole() == 'student' &&
          getUserOrgId() == resource.data.orgId &&
          resource.data.status == 'published' &&
          isCoursePublished(resource.data.courseId) &&
          hasCourseAccess(resource.data.courseId) &&
          (
            resource.data.get('batchId', null) == null ||
            isEnrolledInBatch(resource.data.courseId, resource.data.batchId)
          )
        )
      );

      allow create: if canTeachBatch(request.resource.data.batchId) &&
        isValidDailyAssignment(request.resource.data) &&
        assignmentMatchesPlan(request.resource.data, assignmentId) &&
        request.resource.data.createdById == request.auth.uid;

      // Deadlines and instructions stay editable; marks are frozen once published
      // so earlier grades remain comparable.
      allow update: if canTeachBatch(resource.data.batchId) &&
        isValidDailyAssignment(request.resource.data) &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.courseId == resource.data.courseId &&
        request.resource.data.batchId == resource.data.batchId &&
        request.resource.data.planId == resource.data.planId &&
        request.resource.data.createdById == resource.data.createdById &&
        request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null) &&
        (resource.data.status != 'published' || request.resource.data.totalPoints == resource.data.totalPoints);

      allow delete: if isSuperAdmin();

    }

    // -------------------------------------------------------------------------
    // 11. /submissions/{assignmentId}_{studentId}
    // One record per student per assignment. Timestamps are server time. See
    // docs/DAILY_LEARNING.md §3 for the state machine enforced below.
    // -------------------------------------------------------------------------
    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && isAccountActive() && (
        canReviewSubmission(resource.data) ||
        (isStudent(resource.data.orgId) && resource.data.studentId == request.auth.uid)
      );

      allow create: if isAuthenticated() && isAccountActive() &&
        getUserRole() == 'student' &&
        getUserOrgId() == request.resource.data.orgId &&
        request.resource.data.studentId == request.auth.uid &&
        submissionId == request.resource.data.assignmentId + '_' + request.auth.uid &&
        isValidSubmissionShape(request.resource.data) &&
        request.resource.data.status == 'submitted' &&
        request.resource.data.attemptCount == 1 &&
        request.resource.data.submittedAt == request.time &&
        !('score' in request.resource.data) &&
        !('feedback' in request.resource.data) &&
        !('gradedByUserId' in request.resource.data) &&
        !('gradedAt' in request.resource.data) &&
        canSubmitToAssignment(request.resource.data);

      allow update: if isAuthenticated() && isAccountActive() && (
        (
          // Student (re)submission: only from 'submitted' (edit before review) or
          // 'resubmit_requested' (correction), always back to 'submitted'.
          getUserRole() == 'student' &&
          resource.data.studentId == request.auth.uid &&
          request.resource.data.studentId == request.auth.uid &&
          request.resource.data.orgId == resource.data.orgId &&
          request.resource.data.assignmentId == resource.data.assignmentId &&
          request.resource.data.batchId == resource.data.batchId &&
          request.resource.data.get('courseId', null) == resource.data.get('courseId', null) &&
          isValidSubmissionShape(request.resource.data) &&
          resource.data.status in ['submitted', 'resubmit_requested'] &&
          request.resource.data.status == 'submitted' &&
          request.resource.data.attemptCount == resource.data.get('attemptCount', 1) + 1 &&
          request.resource.data.submittedAt == request.time &&
          request.resource.data.get('score', null) == resource.data.get('score', null) &&
          request.resource.data.get('feedback', null) == resource.data.get('feedback', null) &&
          request.resource.data.get('gradedByUserId', null) == resource.data.get('gradedByUserId', null) &&
          request.resource.data.get('gradedAt', null) == resource.data.get('gradedAt', null) &&
          canSubmitToAssignment(request.resource.data)
        ) ||
        (
          // Review: grade (0..totalPoints) or request a correction (feedback required).
          canReviewSubmission(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['score', 'feedback', 'status', 'gradedByUserId', 'gradedAt', 'updatedAt']) &&
          request.resource.data.gradedByUserId == request.auth.uid &&
          request.resource.data.gradedAt == request.time &&
          (!('feedback' in request.resource.data) ||
            (request.resource.data.feedback is string && request.resource.data.feedback.size() <= 5000)) &&
          (
            (
              request.resource.data.status == 'graded' &&
              resource.data.status in ['submitted', 'graded', 'resubmit_requested'] &&
              request.resource.data.score is number &&
              request.resource.data.score >= 0 &&
              request.resource.data.score <= get(/databases/$(database)/documents/assignments/$(resource.data.assignmentId)).data.totalPoints
            ) ||
            (
              request.resource.data.status == 'resubmit_requested' &&
              resource.data.status in ['submitted', 'graded'] &&
              request.resource.data.feedback is string &&
              request.resource.data.feedback.size() > 0
            )
          )
        )
      );

      allow delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // -------------------------------------------------------------------------
    // 13. /timetables/{timetableId}
    // Stage 8: Weekly Timetables (Monday-Sunday cohort schedules).
    // Revisions must be approved by Super Admin before becoming active.
    // Students only read active approved revisions for their enrolled batch.
    // -------------------------------------------------------------------------
    match /timetables/{timetableId} {
      allow read: if isAuthenticated() && isAccountActive() && (
        canManageBatchTimetable(resource.data.batchId) ||
        (isInstructor(resource.data.orgId) && request.auth.uid in get(/databases/$(database)/documents/batches/$(resource.data.batchId)).data.get('instructorUserIds', [])) ||
        (
          isStudent(resource.data.orgId) &&
          resource.data.activeRevisionId != null &&
          isCoursePublished(resource.data.courseId) &&
          isEnrolledInBatch(resource.data.courseId, resource.data.batchId)
        )
      );

      allow create: if canManageBatchTimetable(request.resource.data.batchId) &&
        timetableId == 'timetable_' + request.resource.data.batchId + '_' + request.resource.data.weekStartDate &&
        isValidTimetableRoot(request.resource.data) &&
        request.resource.data.activeRevisionId == null &&
        request.resource.data.latestStatus == 'draft' &&
        planMatchesOpenBatch(request.resource.data);

      allow update: if isAuthenticated() && isAccountActive() &&
        isValidTimetableRoot(request.resource.data) &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.branchId == resource.data.branchId &&
        request.resource.data.batchId == resource.data.batchId &&
        request.resource.data.courseId == resource.data.courseId &&
        request.resource.data.weekStartDate == resource.data.weekStartDate &&
        request.resource.data.weekEndDate == resource.data.weekEndDate &&
        (
          // Super admin can update everything including activeRevisionId
          isSuperAdmin() ||
          // Branch manager can update currentRevisionId and latestStatus (draft/submitted) but NEVER activeRevisionId
          (
            canManageBatchTimetable(resource.data.batchId) &&
            request.resource.data.activeRevisionId == resource.data.activeRevisionId &&
            request.resource.data.latestStatus in ['draft', 'submitted']
          )
        );

      allow delete: if isSuperAdmin();

      // -----------------------------------------------------------------------
      // 13.1 /timetables/{timetableId}/revisions/{revisionId}
      // Immutable once approved. Only super_admin can approve or request changes.
      // -----------------------------------------------------------------------
      match /revisions/{revisionId} {
        allow read: if isAuthenticated() && isAccountActive() && (
          canManageBatchTimetable(resource.data.batchId) ||
          (isInstructor(resource.data.orgId) && request.auth.uid in get(/databases/$(database)/documents/batches/$(resource.data.batchId)).data.get('instructorUserIds', [])) ||
          (
            isStudent(resource.data.orgId) &&
            revisionId == get(/databases/$(database)/documents/timetables/$(timetableId)).data.activeRevisionId &&
            resource.data.status == 'approved' &&
            isCoursePublished(resource.data.courseId) &&
            isEnrolledInBatch(resource.data.courseId, resource.data.batchId)
          )
        );

        allow create: if canManageBatchTimetable(request.resource.data.batchId) &&
          isValidTimetableRevision(request.resource.data) &&
          request.resource.data.timetableId == timetableId &&
          request.resource.data.status == 'draft' &&
          request.resource.data.createdById == request.auth.uid;

        allow update: if isAuthenticated() && isAccountActive() &&
          // Immutable once approved!
          resource.data.status != 'approved' &&
          isValidTimetableRevision(request.resource.data) &&
          request.resource.data.timetableId == resource.data.timetableId &&
          request.resource.data.orgId == resource.data.orgId &&
          request.resource.data.branchId == resource.data.branchId &&
          request.resource.data.batchId == resource.data.batchId &&
          request.resource.data.courseId == resource.data.courseId &&
          request.resource.data.createdById == resource.data.createdById &&
          request.resource.data.revisionNumber == resource.data.revisionNumber &&
          (
            // Super admin approval: transitioning to 'approved'
            (
              isSuperAdmin() &&
              request.resource.data.status == 'approved' &&
              resource.data.status == 'submitted' &&
              request.resource.data.reviewedById == request.auth.uid
            ) ||
            // Super admin requesting changes: requires non-empty comment
            (
              isSuperAdmin() &&
              request.resource.data.status == 'changes_requested' &&
              resource.data.status == 'submitted' &&
              request.resource.data.reviewedById == request.auth.uid &&
              request.resource.data.reviewComment is string &&
              request.resource.data.reviewComment.size() >= 5
            ) ||
            // Branch manager editing draft or resubmitting
            (
              canManageBatchTimetable(resource.data.batchId) &&
              resource.data.status in ['draft', 'changes_requested'] &&
              request.resource.data.status in ['draft', 'submitted']
            )
          );

        allow delete: if isSuperAdmin() && resource.data.status != 'approved';
      }

      // -----------------------------------------------------------------------
      // 13.2 /timetables/{timetableId}/auditLogs/{logId}
      // Strictly append-only, immutable transition audit trail.
      // -----------------------------------------------------------------------
      match /auditLogs/{logId} {
        allow read: if isAuthenticated() && isAccountActive() && (
          canManageBatchTimetable(get(/databases/$(database)/documents/timetables/$(timetableId)).data.batchId)
        );

        allow create: if isAuthenticated() && isAccountActive() &&
          canManageBatchTimetable(get(/databases/$(database)/documents/timetables/$(timetableId)).data.batchId) &&
          request.resource.data.timetableId == timetableId &&
          isValidTimetableAuditLog(request.resource.data);

        allow update: if false; // Immutability guarantee
        allow delete: if false; // Append-only guarantee
      }
    }

    // 12. /dailyPlans/{batchId}_{date}
    // Instructor-planned learning for one batch and day. Students see published
    // plans of the batch they are enrolled in.
    // -------------------------------------------------------------------------
    match /dailyPlans/{planId} {
      allow read: if isAuthenticated() && isAccountActive() && (
        canTeachBatch(resource.data.batchId) ||
        (
          isStudent(resource.data.orgId) &&
          resource.data.status == 'published' &&
          isCoursePublished(resource.data.courseId) &&
          isEnrolledInBatch(resource.data.courseId, resource.data.batchId)
        )
      );

      allow create: if canTeachBatch(request.resource.data.batchId) &&
        planId == request.resource.data.batchId + '_' + request.resource.data.date &&
        isValidDailyPlan(request.resource.data) &&
        planMatchesOpenBatch(request.resource.data) &&
        request.resource.data.createdById == request.auth.uid;

      allow update: if canTeachBatch(resource.data.batchId) &&
        isValidDailyPlan(request.resource.data) &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.branchId == resource.data.branchId &&
        request.resource.data.courseId == resource.data.courseId &&
        request.resource.data.batchId == resource.data.batchId &&
        request.resource.data.date == resource.data.date &&
        request.resource.data.createdById == resource.data.createdById &&
        request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null) &&
        planMatchesOpenBatch(request.resource.data);

      allow delete: if isSuperAdmin();
    }
  }
}
