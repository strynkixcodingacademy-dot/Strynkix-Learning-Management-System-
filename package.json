{
  "name": "strynkix-lms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/academy tests/auth tests/livebook tests/admin tests/courses tests/batches tests/migration tests/learning tests/analytics tests/help tests/review tests/backup",
    "test:rules": "vitest run tests/rules tests/emulator --no-file-parallelism",
    "test:emulator": "JAVA_HOME=\"${JAVA_HOME:-/opt/homebrew/opt/openjdk@21}\" PATH=\"/opt/homebrew/opt/openjdk@21/bin:$PATH\" firebase emulators:exec --project demo-strynkix-lms --only auth,firestore \"npm run test:rules\"",
    "test": "npm run test:unit && npm run test:emulator",
    "test:e2e": "JAVA_HOME=\"${JAVA_HOME:-/opt/homebrew/opt/openjdk@21}\" PATH=\"/opt/homebrew/opt/openjdk@21/bin:$PATH\" firebase emulators:exec --project demo-strynkix-e2e --only auth,firestore \"playwright test\"",
    "seed:emulator": "tsx scripts/bootstrap-emulator.ts",
    "bootstrap:emulator": "JAVA_HOME=\"${JAVA_HOME:-/opt/homebrew/opt/openjdk@21}\" PATH=\"/opt/homebrew/opt/openjdk@21/bin:$PATH\" firebase emulators:exec --only auth,firestore \"npm run seed:emulator\"",
    "verify:journey": "tsx scripts/verify-student-journey.ts",
    "verify:batch-workflow": "tsx scripts/verify-batch-workflow.ts",
    "verify:emulator": "JAVA_HOME=\"${JAVA_HOME:-/opt/homebrew/opt/openjdk@21}\" PATH=\"/opt/homebrew/opt/openjdk@21/bin:$PATH\" firebase emulators:exec --only firestore \"npm run verify:journey && npm run verify:batch-workflow\"",
    "migration:enrollments": "tsx scripts/migration/enrollment-migration.ts",
    "migration:quiz-keys": "tsx scripts/migration/quiz-key-migration.ts",
    "check:admin-env": "tsx scripts/ops/check-admin-env.ts",
    "backup:firestore-export": "tsx scripts/backup/firestore-export.ts",
    "backup:firestore-restore": "tsx scripts/backup/firestore-restore.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@number-flow/react": "0.6.2",
    "canvas-confetti": "1.9.4",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.62.0",
    "motion": "14.2.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
