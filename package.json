{
  "name": "strynkix-lms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/auth tests/livebook tests/admin tests/courses tests/batches tests/migration tests/learning",
    "test:rules": "vitest run tests/rules tests/emulator --no-file-parallelism",
    "test:emulator": "JAVA_HOME=\"${JAVA_HOME:-/opt/homebrew/opt/openjdk@21}\" PATH=\"/opt/homebrew/opt/openjdk@21/bin:$PATH\" firebase emulators:exec --only firestore \"npm run test:rules\"",
    "test": "npm run test:unit && npm run test:emulator",
    "seed:emulator": "tsx scripts/bootstrap-emulator.ts",
    "bootstrap:emulator": "JAVA_HOME=\"${JAVA_HOME:-/opt/homebrew/opt/openjdk@21}\" PATH=\"/opt/homebrew/opt/openjdk@21/bin:$PATH\" firebase emulators:exec --only auth,firestore \"npm run seed:emulator\"",
    "verify:journey": "tsx scripts/verify-student-journey.ts",
    "verify:batch-workflow": "tsx scripts/verify-batch-workflow.ts",
    "verify:emulator": "JAVA_HOME=\"${JAVA_HOME:-/opt/homebrew/opt/openjdk@21}\" PATH=\"/opt/homebrew/opt/openjdk@21/bin:$PATH\" firebase emulators:exec --only firestore \"npm run verify:journey && npm run verify:batch-workflow\"",
    "migration:enrollments": "tsx scripts/migration/enrollment-migration.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
